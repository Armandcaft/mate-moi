{
	"name": "mate-moi",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"player": "node scripts/player.ts",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"start": "node build"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@fontsource/cinzel": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"better-sqlite3": "^13.2.0",
		"drizzle-orm": "^0.45.4",
		"satori": "^0.63.2"
	},
	"engines": {
		"node": ">=22.18"
	}
}
